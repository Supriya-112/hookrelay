# Development image: a modern Ruby plus the Postgres client headers the `pg`
# gem builds against. Gems and the app are mounted in via docker-compose, so
# this stays tiny and rebuilds rarely. Production uses the generated Dockerfile.
FROM ruby:3.3

RUN apt-get update -qq \
 && apt-get install -y --no-install-recommends libpq-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /app
