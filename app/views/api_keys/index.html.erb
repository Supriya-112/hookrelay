<% content_for :title, "API keys — Hookrelay" %>

<h1>API keys</h1>
<p class="meta">
  A key replays events without a browser: send it as
  <code>Authorization: Bearer &lt;key&gt;</code>. Only the digest is stored, so a
  key that is lost has to be revoked and replaced.
</p>

<% if @issued_key.present? %>
  <section>
    <h2>Your new key</h2>
    <pre class="payload"><%= @issued_key %></pre>
  </section>
<% end %>

<section>
  <div class="section-head">
    <h2>Keys</h2>
  </div>

  <% if @api_keys.any? %>
    <table class="grid">
      <thead>
        <tr>
          <th>Name</th>
          <th>Created</th>
          <th>Last used</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @api_keys.each do |api_key| %>
          <tr>
            <td><%= api_key.name %></td>
            <td><%= relative_time(api_key.created_at) %></td>
            <td><%= relative_time(api_key.last_used_at) %></td>
            <td class="num">
              <%= button_to "Revoke", api_key_path(api_key), method: :delete, class: "btn btn-small" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="empty">No keys yet.</p>
  <% end %>
</section>

<section>
  <h2>New key</h2>
  <%= form_with url: api_keys_path, class: "form form-inline" do |form| %>
    <%= form.label :name, "Name" %>
    <%= form.text_field :name, placeholder: "deploy script" %>
    <%= form.submit "Create key", class: "btn" %>
  <% end %>
</section>
